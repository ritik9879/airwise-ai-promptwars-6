    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.6.0",
    "jsdom": "26.1.0",
